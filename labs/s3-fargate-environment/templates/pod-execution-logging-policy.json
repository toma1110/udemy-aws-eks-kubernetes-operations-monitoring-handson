{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteDedicatedTrainingLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-northeast-1:*:log-group:/aws/eks/eks-fargate-ops-lab/containers:*"
    }
  ]
}
